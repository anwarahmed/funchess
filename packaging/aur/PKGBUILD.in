# Maintainer: Anwar Ahmed <anwar dot ahmed at gmail dot com>
#
# Generated by packaging/aur/render.sh in https://github.com/anwarahmed/funchess
# for each release; edit the template there, not this file.

pkgname=funchess-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Chess for the terminal: against the computer, two players, or over the network"
arch=('x86_64' 'aarch64')
url="https://github.com/anwarahmed/funchess"
license=('MIT')
provides=('funchess')
conflicts=('funchess')
# The binaries are static and already stripped of debug info.
options=('!strip' '!debug')
source=("funchess-$pkgver-LICENSE::https://raw.githubusercontent.com/anwarahmed/funchess/v$pkgver/LICENSE")
source_x86_64=("funchess-$pkgver-x86_64::$url/releases/download/v$pkgver/funchess-x86_64-unknown-linux-musl")
source_aarch64=("funchess-$pkgver-aarch64::$url/releases/download/v$pkgver/funchess-aarch64-unknown-linux-musl")
sha256sums=('@SHA_LICENSE@')
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
    install -Dm755 "$srcdir/funchess-$pkgver-$CARCH" "$pkgdir/usr/bin/funchess"
    install -Dm644 "$srcdir/funchess-$pkgver-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # pacman owns this copy: the marker tells the game never to update itself. It looks
    # for it at ../share/funchess/managed-by from the directory of its binary.
    install -d "$pkgdir/usr/share/funchess"
    echo "pacman; update the funchess-bin package" > "$pkgdir/usr/share/funchess/managed-by"
}
