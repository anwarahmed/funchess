pkgbase = funchess-bin
	pkgdesc = Chess for the terminal: against the computer, two players, or over the network
	pkgver = @VERSION@
	pkgrel = 1
	url = https://github.com/anwarahmed/funchess
	arch = x86_64
	arch = aarch64
	license = MIT
	provides = funchess
	conflicts = funchess
	options = !strip
	options = !debug
